# Sao chép file này thành .env.local rồi điền giá trị từ Supabase
# (Project Settings → API Keys, hoặc nút "Connect" ở đầu trang dashboard)
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Publishable key (sb_publishable_...). KHÔNG dùng secret key / service_role key.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# (Tùy chọn) Thông báo đẩy nhắc học: public key tạo bằng `npx web-push generate-vapid-keys`
# Xem README, mục "Nhắc học". Để trống thì app chỉ dùng lời nhắc qua Lịch.
VITE_VAPID_PUBLIC_KEY=
